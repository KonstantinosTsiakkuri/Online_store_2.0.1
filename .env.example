# Django
SECRET_KEY=
DEBUG=

# PostgreSQL
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Суперпользователь Django (для createsuperuser --noinput)
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# Почта (SMTP). Если не заполнить — письма печатаются в консоль сервера.
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USE_SSL=
EMAIL_USE_TLS=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
SERVER_EMAIL=

# Кеширование (Redis). CACHE_ENABLED=False — работа без Redis (DummyCache).
CACHE_ENABLED=False
REDIS_LOCATION=redis://127.0.0.1:6379/1
CACHE_TTL_PRODUCT_DETAIL=900
CACHE_TTL_CATEGORY_PRODUCTS=900
